<Window x:Class="TrainGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:TrainGame.UI"
        mc:Ignorable="d"
        Title="🚂 TrenSim 2D — Juego de Puzles Ferroviarios" 
        Height="840" Width="1340"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilos de Botones de Herramientas -->
        <Style x:Key="ToolButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Gigante de Lanzamiento (Run Simulation) -->
        <Style x:Key="BigPlayBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#22C55E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#15803D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtnStyle" TargetType="Button" BasedOn="{StaticResource ActionBtnStyle}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= BARRA SUPERIOR (SELECTOR DE PUZLE & ACCIONES) ================= -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="False">
                <!-- Logotipo & Modo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="🧩" FontSize="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="TrenSim Puzles" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    <Border Background="#8B5CF6" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MODO PUZLE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- Selector de Niveles -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="24,0,0,0">
                    <Button x:Name="BtnPrevLevel" Content="◀ Anterior" Style="{StaticResource ActionBtnStyle}" Click="BtnPrevLevel_Click"/>
                    <Border Background="#0F172A" CornerRadius="6" Padding="14,6" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtLevelTitle" Text="Nivel 1: Primeros Raíles" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtLevelStars" Text=" ⭐⭐⭐" FontSize="14" Foreground="#FACC15" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnNextLevel" Content="Siguiente ▶" Style="{StaticResource ActionBtnStyle}" Click="BtnNextLevel_Click"/>
                </StackPanel>

                <!-- Botón Principal ¡ARRANCAR / REINICIAR! y Controles -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Button x:Name="BtnRunPuzzle" Content="▶️ ¡ARRANCAR TRENES!" Style="{StaticResource BigPlayBtnStyle}" Click="BtnRunPuzzle_Click" ToolTip="Pon a prueba tu trazado de vías"/>
                    <Button x:Name="BtnResetPuzzle" Content="🔄 Ajustar Vías" Style="{StaticResource ActionBtnStyle}" Click="BtnResetPuzzle_Click" ToolTip="Regresa los trenes al inicio para ajustar las vías"/>

                    <Rectangle Width="1" Height="24" Fill="#475569" Margin="10,0"/>

                    <Button Content="🎯 Centrar" Style="{StaticResource ActionBtnStyle}" Click="BtnResetView_Click"/>
                    <Button Content="🗑️ Borrar Todo" Style="{StaticResource DangerBtnStyle}" Click="BtnClearMap_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= ÁREA PRINCIPAL ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- BARRA DE HERRAMIENTAS IZQUIERDA -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PIEZAS DE VÍA" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="4,0,0,8"/>

                        <RadioButton x:Name="ToolAuto" Content="🛤️ Auto-Vía (Inteligente)" Style="{StaticResource ToolButtonStyle}" IsChecked="True" Checked="Tool_Checked" Tag="AutoTrack" ToolTip="Arrastra para conectar automáticamente"/>
                        <RadioButton Content="─ Recta Horizontal" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="StraightH"/>
                        <RadioButton Content="│ Recta Vertical" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="StraightV"/>

                        <Separator Background="#334155" Margin="0,8"/>
                        <TextBlock Text="CURVAS Y CRUCES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="4,0,0,6"/>

                        <RadioButton Content="⮡ Curva Norte-Este" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="CurveNE"/>
                        <RadioButton Content="⮣ Curva Este-Sur" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="CurveES"/>
                        <RadioButton Content="⮠ Curva Sur-Oeste" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="CurveSW"/>
                        <RadioButton Content="⮢ Curva Oeste-Norte" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="CurveWN"/>
                        <RadioButton Content="➕ Cruce en Cruz" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="Cross"/>

                        <Separator Background="#334155" Margin="0,8"/>
                        <TextBlock Text="HERRAMIENTAS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="4,0,0,6"/>

                        <RadioButton Content="👆 Seleccionar" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="Select"/>
                        <RadioButton Content="🗑️ Borrar Vía" Style="{StaticResource ToolButtonStyle}" Checked="Tool_Checked" Tag="DeleteTrack" ToolTip="O usa clic derecho"/>

                        <Separator Background="#334155" Margin="0,12"/>
                        <!-- Selector Rápido de Nivel -->
                        <TextBlock Text="LISTA DE NIVELES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="4,0,0,6"/>
                        <StackPanel x:Name="PanelLevelList"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CANVAS DE PUZLE -->
            <ui:GameCanvas x:Name="CanvasGame" Grid.Column="1"/>

            <!-- PANEL LATERAL DERECHO (OBJETIVOS & ESTADO) -->
            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1,0,0,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- TARJETA DE RESULTADO (VICTORIA / DERROTA) -->
                        <Border x:Name="CardResult" Visibility="Collapsed" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtResultHeader" Text="🎉 ¡NIVEL COMPLETADO!" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtResultStars" Text="⭐⭐⭐" FontSize="20" HorizontalAlignment="Center" Margin="0,4"/>
                                <TextBlock x:Name="TxtResultMsg" Text="Todos los trenes llegaron con éxito a sus estaciones." TextWrapping="Wrap" FontSize="12" TextAlignment="Center" Margin="0,4,0,10"/>
                                <Button x:Name="BtnNextLevelCard" Content="▶ Siguiente Nivel" Style="{StaticResource BigPlayBtnStyle}" Margin="0,4" Click="BtnNextLevel_Click"/>
                                <Button Content="🔄 Reintentar para 3 Estrellas" Style="{StaticResource ActionBtnStyle}" Margin="0,4" Click="BtnResetPuzzle_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- OBJETIVO DEL NIVEL -->
                        <TextBlock Text="OBJETIVO DEL PUZLE" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtLevelDesc" Text="Lleva el tren a la estación correspondiente." FontSize="13" Foreground="#F8FAFC" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtLevelHint" Text="💡 Pista: Traza vías directas." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- PRESUPUESTO DE VÍAS Y ESTRELLAS -->
                        <TextBlock Text="PRESUPUESTO DE VÍAS" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="Vías colocadas:" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtTracksUsed" Text="0 / 6" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ProgressBar x:Name="ProgressTrackBudget" Height="8" Minimum="0" Maximum="6" Value="0" Margin="0,6,0,8" Foreground="#2563EB" Background="#334155"/>
                                
                                <Separator Background="#334155" Margin="0,4"/>
                                <TextBlock Text="Desafío de Estrellas:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,4,0,4"/>
                                <TextBlock x:Name="TxtStar3Goal" Text="⭐⭐⭐ : 4 vías o menos" FontSize="11" Foreground="#FACC15" Margin="0,1"/>
                                <TextBlock x:Name="TxtStar2Goal" Text="⭐⭐ : 5 vías" FontSize="11" Foreground="#E2E8F0" Margin="0,1"/>
                                <TextBlock x:Name="TxtStar1Goal" Text="⭐ : 6 vías" FontSize="11" Foreground="#94A3B8" Margin="0,1"/>
                            </StackPanel>
                        </Border>

                        <!-- ESTADO EN VIVO -->
                        <TextBlock Text="ESTADO" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtPuzzleStatusMsg" Text="Planificando vías..." Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- GUÍA RÁPIDA -->
                        <TextBlock Text="CÓMO JUGAR" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Border Background="#0F172A" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="1. Trazar vías conectando cada tren con su estación del mismo color." Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Text="2. Pulsa '¡ARRANCAR TRENES!' para probar la solución." Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Text="3. Si el tren llega sin descarrilar ni chocar, ¡ganas el nivel!" Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" Margin="0,2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= BARRA INFERIOR ================= -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="TxtFooterStatus" Text="Modo: Auto-Vía | Conecta los trenes con sus estaciones de destino." Foreground="#94A3B8" FontSize="12"/>
                <TextBlock Text="TrenSim 2D • Modo Puzle" Foreground="#64748B" FontSize="12" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
